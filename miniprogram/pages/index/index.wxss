.container {
  min-height: 100vh;
  background-color: #FFF8E7;
}

.hero-swiper {
  height: 500rpx;
  background: linear-gradient(180deg, rgba(93, 64, 55, 0.9) 0%, rgba(230, 126, 34, 0.7) 100%);
}

.hero-item {
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60rpx;
}

.hero-content {
  text-align: center;
}

.hero-subtitle {
  display: block;
  font-size: 28rpx;
  color: #D4A574;
  margin-bottom: 20rpx;
}

.hero-title {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #FFF8E7;
  margin-bottom: 30rpx;
}

.hero-quote {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 248, 231, 0.9);
  font-style: italic;
}

.stats-section {
  padding: 60rpx 40rpx;
}

.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 30rpx;
}

.stat-card {
  background: linear-gradient(145deg, #FFF8E7 0%, #FFF5E6 100%);
  border-radius: 20rpx;
  padding: 40rpx 30rpx;
  text-align: center;
  box-shadow: 0 4rpx 20rpx rgba(93, 64, 55, 0.1);
  border: 1rpx solid rgba(212, 165, 116, 0.2);
}

.stat-value {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #5D4037;
  margin-bottom: 10rpx;
}

.stat-label {
  display: block;
  font-size: 24rpx;
  color: rgba(93, 64, 55, 0.7);
}

.quick-search-section {
  padding: 0 40rpx 40rpx;
}

.section-header {
  margin-bottom: 30rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #5D4037;
}

.search-box {
  display: flex;
  gap: 20rpx;
}

.search-input {
  flex: 1;
  height: 88rpx;
  background: #FFF5E6;
  border: 2rpx solid rgba(212, 165, 116, 0.3);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  padding: 0 30rpx;
}

.search-placeholder {
  font-size: 28rpx;
  color: rgba(93, 64, 55, 0.5);
}

.search-btn {
  height: 88rpx;
  background: #E67E22;
  color: #FFF8E7;
  border: none;
  border-radius: 16rpx;
  padding: 0 40rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.search-btn::after {
  border: none;
}

.action-section {
  padding: 60rpx 40rpx;
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.primary-btn {
  background: #E67E22;
  color: #FFF8E7;
  border: none;
  border-radius: 16rpx;
  padding: 30rpx;
  font-size: 32rpx;
  font-weight: bold;
  box-shadow: 0 8rpx 24rpx rgba(230, 126, 34, 0.3);
}

.primary-btn::after {
  border: none;
}

.secondary-btn {
  background: #FFF8E7;
  color: #5D4037;
  border: 2rpx solid #D4A574;
  border-radius: 16rpx;
  padding: 30rpx;
  font-size: 32rpx;
  font-weight: bold;
}

.secondary-btn::after {
  border: none;
}
